# ==========================================================================
#  B2B 外贸官网 —— 全站统一配置文件
#  复制本文件为 .env 后按实际信息修改；.env 不会进入镜像/仓库，仅由
#  docker compose 注入容器并供 FastAPI 读取
# ==========================================================================

# ---------- 运行环境 ----------
APP_ENV=production
# Docker Compose 项目名（只允许小写英文/数字/短横线；中文目录名时必须显式指定）
COMPOSE_PROJECT_NAME=b2b-website
# 站点对外访问域名（含 https，结尾不带斜杠），用于 SEO canonical / sitemap / 邮件链接
SITE_DOMAIN=https://www.example.com
# 对外暴露的 HTTP 端口（宿主机端口，服务器安全组/防火墙需放行）
NGINX_HTTP_PORT=8080

# ---------- 公司信息（全站所有页面/页脚/邮件共用） ----------
COMPANY_NAME=NovaForge Industries Ltd.
COMPANY_TAGLINE=Precision Manufacturing, Engineered for the World.
COMPANY_SHORT=NOVAFORGE
COMPANY_DESCRIPTION=ISO 9001 certified manufacturer of precision machined components, industrial automation modules and custom fabrication, exporting to 40+ countries.
COMPANY_FOUNDED_YEAR=2008
COMPANY_EMPLOYEES=320
COMPANY_COUNTRIES=40
COMPANY_FACTORY_AREA=18000

# ---------- 联系方式 ----------
COMPANY_EMAIL=sales@example.com
COMPANY_PHONE=+86 21 8888 6666
COMPANY_WHATSAPP=+86 138 0000 0000
COMPANY_ADDRESS=No. 88, Innovation Avenue, Jiading District, Shanghai, China
COMPANY_HOURS=Mon - Sat, 9:00 - 18:00 (GMT+8)

# ---------- 社交媒体（留空则页脚自动隐藏对应入口） ----------
LINKEDIN_URL=https://www.linkedin.com/company/example
FACEBOOK_URL=https://www.facebook.com/example
YOUTUBE_URL=https://www.youtube.com/@example
INSTAGRAM_URL=

# ---------- SEO ----------
SEO_TITLE=NovaForge | Precision Manufacturing & Industrial Components Supplier
SEO_DESCRIPTION=ISO 9001 certified China manufacturer: CNC precision machining, industrial automation modules, custom sheet metal fabrication. OEM/ODM, factory-direct, exporting to 40+ countries. Request a quote today.
SEO_KEYWORDS=precision manufacturing, CNC machining China, industrial components manufacturer, OEM supplier, custom metal fabrication, factory direct wholesale, B2B manufacturing, automation modules
SEO_OG_IMAGE=/static/img/og-cover.jpg

# ---------- 数据库（SQLite，容器内路径，默认挂载到宿主机 ./data） ----------
DATABASE_URL=sqlite:////app/data/inquiries.db

# ---------- 询盘邮件通知（SMTP） ----------
# 客户提交询盘后：1) 发送通知邮件给公司  2) 自动回复客户确认函
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your-smtp-password-or-app-token
SMTP_FROM=notifications@example.com
SMTP_FROM_NAME=NovaForge Website
# 接收询盘通知的邮箱（一般为销售邮箱）
MAIL_TO=sales@example.com
# 465 = SSL；587 = STARTTLS；留空 SMTP_HOST 则不发送邮件（仅入库）
SMTP_USE_SSL=true

# ---------- GitHub Container Registry（服务器部署时由 CI 注入，可留空） ----------
# 镜像地址格式：ghcr.io/<GitHub用户名或组织>/<仓库名>
GHCR_IMAGE=ghcr.io/your-github-name/your-repo:latest
